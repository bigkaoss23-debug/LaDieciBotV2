{
  "name": "ladieci-app",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "node scripts/guard-no-lab-markers.js && node scripts/guard-env-fail-closed.js && node scripts/generate-functions-public-env.js && node scripts/write-version.js",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:watch": "react-scripts test",
    "test:standalone": "node scripts/run-standalone-tests.js standalone",
    "test:mjs": "node scripts/run-standalone-tests.js mjs",
    "test:all": "npm run test && npm run test:standalone && npm run test:mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
