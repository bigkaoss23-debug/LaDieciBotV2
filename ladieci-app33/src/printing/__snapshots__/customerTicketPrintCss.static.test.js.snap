exports[`customer ticket print-ready CSS uses the exact thermal PNG at the same 20 mm size in preview and physical print 1`] = `"<div class=\\"ticket-document paper-58\\" data-paper-width=\\"58\\" style=\\"--ticket-characters-per-line:32\\"><div class=\\"ticket-document-image role-business-logo\\"><img src=\\"/printing/la-dieci-thermal-logo.png\\" alt=\\"La Dieci\\"/></div><div class=\\"ticket-document-text align-center emphasis-normal size-normal role-secondary\\">PIZZERÍA</div><div class=\\"ticket-document-text align-center emphasis-normal size-normal role-secondary\\">Plaza Itálica 8</div><div class=\\"ticket-document-text align-center emphasis-normal size-normal role-secondary\\">Roquetas de Mar</div><div class=\\"ticket-document-separator\\" aria-hidden=\\"true\\"></div><div class=\\"ticket-document-columns\\" style=\\"grid-template-columns:3fr 18fr 9fr\\"><span class=\\"align-left emphasis-normal\\">1×</span><span class=\\"align-left emphasis-bold\\">Margarita de</span><span class=\\"align-right emphasis-normal role-money\\">9,00 €</span></div><div class=\\"ticket-document-text align-left emphasis-normal size-normal\\">    prueba</div><div class=\\"ticket-document-separator\\" aria-hidden=\\"true\\"></div><div class=\\"ticket-document-text align-right emphasis-bold size-large role-money\\">TOTAL 9,00 €</div><div class=\\"ticket-document-text align-left emphasis-bold size-normal\\">PAGADO · TARJETA</div><div class=\\"ticket-document-separator\\" aria-hidden=\\"true\\"></div><div class=\\"ticket-document-text align-center emphasis-bold size-normal\\">RITIRO · 20:20</div><div class=\\"ticket-document-text align-center emphasis-bold size-xlarge\\">PEDIDO #111</div><div class=\\"ticket-document-text align-center emphasis-normal size-normal role-secondary\\">15/01/2026, 20:00</div><div class=\\"ticket-document-separator\\" aria-hidden=\\"true\\"></div><div class=\\"ticket-document-text align-center emphasis-normal size-normal role-secondary\\">Gracias por tu pedido<